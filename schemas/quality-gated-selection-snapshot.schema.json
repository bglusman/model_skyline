{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:model-skyline:schema:v1alpha1:quality-gated-selection-snapshot",
  "$defs": {
    "AxisDescriptor": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "goal": {
          "$ref": "#/$defs/Goal"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "epsilon_absolute": {
          "default": "0",
          "maxLength": 1024,
          "pattern": "^[+-]?\\d+(?:\\.\\d+)?$",
          "title": "Epsilon Absolute",
          "type": "string"
        },
        "epsilon_relative": {
          "default": "0",
          "maxLength": 1024,
          "pattern": "^[+-]?\\d+(?:\\.\\d+)?$",
          "title": "Epsilon Relative",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "goal",
        "unit"
      ],
      "title": "AxisDescriptor",
      "type": "object"
    },
    "AxisEstimate": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maxLength": 1024,
          "pattern": "^[+-]?\\d+(?:\\.\\d+)?$",
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "maxLength": 1024,
              "pattern": "^[+-]?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "maxLength": 1024,
              "pattern": "^[+-]?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "dependencies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "source_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Sources",
          "type": "array"
        },
        "oldest_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oldest Observed At"
        },
        "minimum_sample_count": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Sample Count"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "AxisEstimate",
      "type": "object"
    },
    "CandidateRankEvidence": {
      "additionalProperties": false,
      "properties": {
        "rank": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "primary_rank": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Primary Rank",
          "type": "integer"
        },
        "offering": {
          "$ref": "#/$defs/OfferingKey"
        },
        "axes": {
          "additionalProperties": {
            "$ref": "#/$defs/AxisEstimate"
          },
          "title": "Axes",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "priority_groups": {
          "items": {
            "$ref": "#/$defs/PriorityGroupRankEvidence"
          },
          "maxItems": 32,
          "title": "Priority Groups",
          "type": "array"
        }
      },
      "required": [
        "rank",
        "primary_rank",
        "offering",
        "axes",
        "priority_groups"
      ],
      "title": "CandidateRankEvidence",
      "type": "object"
    },
    "CrossFrontierSelectionPolicy": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "const": "priority-group-overlap",
          "default": "priority-group-overlap",
          "title": "Strategy",
          "type": "string"
        },
        "priority_groups": {
          "items": {
            "$ref": "#/$defs/FrontierPriorityGroup"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Priority Groups",
          "type": "array"
        }
      },
      "required": [
        "priority_groups"
      ],
      "title": "CrossFrontierSelectionPolicy",
      "type": "object"
    },
    "EvaluatedOffering": {
      "additionalProperties": false,
      "properties": {
        "offering": {
          "$ref": "#/$defs/OfferingKey"
        },
        "axes": {
          "additionalProperties": {
            "$ref": "#/$defs/AxisEstimate"
          },
          "title": "Axes",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "dominated_by": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dominated By",
          "type": "array"
        }
      },
      "required": [
        "offering",
        "axes"
      ],
      "title": "EvaluatedOffering",
      "type": "object"
    },
    "FrontierPriorityGroup": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "frontiers": {
          "items": {
            "$ref": "#/$defs/SecondaryFrontierReference"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Frontiers",
          "type": "array"
        }
      },
      "required": [
        "name",
        "frontiers"
      ],
      "title": "FrontierPriorityGroup",
      "type": "object"
    },
    "FrontierRankEvidence": {
      "additionalProperties": false,
      "properties": {
        "frontier_id": {
          "minLength": 1,
          "title": "Frontier Id",
          "type": "string"
        },
        "frontier_snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Frontier Snapshot Id",
          "type": "string"
        },
        "proximity_snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Proximity Snapshot Id",
          "type": "string"
        },
        "measured": {
          "title": "Measured",
          "type": "boolean"
        },
        "exact_member": {
          "title": "Exact Member",
          "type": "boolean"
        },
        "near_member": {
          "title": "Near Member",
          "type": "boolean"
        },
        "minimal_relative_epsilon": {
          "anyOf": [
            {
              "ge": 0,
              "le": "2",
              "maxLength": 1024,
              "pattern": "^[+-]?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimal Relative Epsilon"
        },
        "axis_slacks": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/ProximityAxisSlack"
                },
                {
                  "$ref": "#/$defs/ProximityAxisSlack"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 0,
              "minItems": 0,
              "type": "array"
            }
          ],
          "default": [],
          "title": "Axis Slacks"
        }
      },
      "required": [
        "frontier_id",
        "frontier_snapshot_id",
        "proximity_snapshot_id",
        "measured",
        "exact_member",
        "near_member"
      ],
      "title": "FrontierRankEvidence",
      "type": "object"
    },
    "FrontierSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "model-skyline/v1alpha1",
          "default": "model-skyline/v1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "frontier",
          "default": "frontier",
          "title": "Kind",
          "type": "string"
        },
        "hash_algorithm": {
          "const": "sha256-rfc8785-v1",
          "default": "sha256-rfc8785-v1",
          "title": "Hash Algorithm",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "config_hash": {
          "title": "Config Hash",
          "type": "string"
        },
        "catalog_hash": {
          "title": "Catalog Hash",
          "type": "string"
        },
        "engine_version": {
          "title": "Engine Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "frontier_id": {
          "title": "Frontier Id",
          "type": "string"
        },
        "workload": {
          "$ref": "#/$defs/WorkloadReference"
        },
        "order_by": {
          "title": "Order By",
          "type": "string"
        },
        "uncertainty": {
          "$ref": "#/$defs/UncertaintyMode"
        },
        "axes": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/AxisDescriptor"
            },
            {
              "$ref": "#/$defs/AxisDescriptor"
            }
          ],
          "title": "Axes",
          "type": "array"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/EvaluatedOffering"
          },
          "title": "Members",
          "type": "array"
        },
        "evaluated": {
          "items": {
            "$ref": "#/$defs/EvaluatedOffering"
          },
          "title": "Evaluated",
          "type": "array"
        },
        "rejected": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RejectedOffering"
          },
          "title": "Rejected",
          "type": "array"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Sources",
          "type": "array"
        },
        "source_watermarks": {
          "additionalProperties": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Source Watermarks",
          "type": "object"
        }
      },
      "required": [
        "snapshot_id",
        "config_hash",
        "catalog_hash",
        "engine_version",
        "generated_at",
        "frontier_id",
        "workload",
        "order_by",
        "uncertainty",
        "axes",
        "members",
        "evaluated"
      ],
      "title": "FrontierSnapshot",
      "type": "object"
    },
    "Goal": {
      "enum": [
        "minimize",
        "maximize"
      ],
      "title": "Goal",
      "type": "string"
    },
    "InsufficientCandidates": {
      "enum": [
        "error",
        "return_available"
      ],
      "title": "InsufficientCandidates",
      "type": "string"
    },
    "JsonValue": {},
    "ModelChoice": {
      "additionalProperties": false,
      "properties": {
        "offering": {
          "$ref": "#/$defs/OfferingKey"
        },
        "axes": {
          "additionalProperties": {
            "$ref": "#/$defs/AxisEstimate"
          },
          "title": "Axes",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "offering",
        "axes"
      ],
      "title": "ModelChoice",
      "type": "object"
    },
    "MultiFrontierSelectionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "model-skyline/selection-overlap/v1alpha1",
          "default": "model-skyline/selection-overlap/v1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "multi-frontier-selection",
          "default": "multi-frontier-selection",
          "title": "Kind",
          "type": "string"
        },
        "hash_algorithm": {
          "const": "sha256-rfc8785-v1",
          "default": "sha256-rfc8785-v1",
          "title": "Hash Algorithm",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "primary_frontier_snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Primary Frontier Snapshot Id",
          "type": "string"
        },
        "primary_frontier_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Primary Frontier Snapshot Hash",
          "type": "string"
        },
        "selection_id": {
          "minLength": 1,
          "title": "Selection Id",
          "type": "string"
        },
        "frontier_id": {
          "minLength": 1,
          "title": "Frontier Id",
          "type": "string"
        },
        "workload": {
          "$ref": "#/$defs/WorkloadReference"
        },
        "strategy": {
          "const": "priority-group-overlap",
          "default": "priority-group-overlap",
          "title": "Strategy",
          "type": "string"
        },
        "order_by": {
          "minLength": 1,
          "title": "Order By",
          "type": "string"
        },
        "requested_count": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Requested Count",
          "type": "integer"
        },
        "max_per_provider": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Per Provider"
        },
        "on_insufficient": {
          "$ref": "#/$defs/InsufficientCandidates"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/CrossFrontierSelectionPolicy"
        },
        "ranked_candidates": {
          "items": {
            "$ref": "#/$defs/CandidateRankEvidence"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Ranked Candidates",
          "type": "array"
        },
        "default": {
          "$ref": "#/$defs/ModelChoice"
        },
        "fallbacks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelChoice"
          },
          "maxItems": 9999,
          "title": "Fallbacks",
          "type": "array"
        }
      },
      "required": [
        "snapshot_id",
        "policy_hash",
        "primary_frontier_snapshot_id",
        "primary_frontier_snapshot_hash",
        "selection_id",
        "frontier_id",
        "workload",
        "order_by",
        "requested_count",
        "on_insufficient",
        "generated_at",
        "valid_until",
        "policy",
        "ranked_candidates",
        "default"
      ],
      "title": "MultiFrontierSelectionSnapshot",
      "type": "object"
    },
    "OfferingKey": {
      "additionalProperties": false,
      "description": "Identity grain for a routable candidate, narrower than model name.",
      "properties": {
        "offering_id": {
          "minLength": 1,
          "title": "Offering Id",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "billing_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Billing Mode"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "service_tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Tier"
        },
        "quantization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantization"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "agent_harness": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Harness"
        },
        "capabilities": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Capabilities",
          "type": "array"
        }
      },
      "required": [
        "offering_id",
        "model_id",
        "provider",
        "endpoint",
        "billing_mode",
        "region",
        "service_tier",
        "quantization",
        "reasoning_effort",
        "agent_harness",
        "capabilities"
      ],
      "title": "OfferingKey",
      "type": "object"
    },
    "PriorityGroupRankEvidence": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "exact_memberships": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Exact Memberships",
          "type": "integer"
        },
        "near_memberships": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Near Memberships",
          "type": "integer"
        },
        "frontiers": {
          "items": {
            "$ref": "#/$defs/FrontierRankEvidence"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Frontiers",
          "type": "array"
        }
      },
      "required": [
        "name",
        "exact_memberships",
        "near_memberships",
        "frontiers"
      ],
      "title": "PriorityGroupRankEvidence",
      "type": "object"
    },
    "ProximityAxisSlack": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "normalized_dominance_slack": {
          "maxLength": 1024,
          "pattern": "^[+-]?\\d+(?:\\.\\d+)?$",
          "title": "Normalized Dominance Slack",
          "type": "string"
        },
        "witnesses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OfferingKey"
          },
          "maxItems": 128,
          "title": "Witnesses",
          "type": "array"
        }
      },
      "required": [
        "metric",
        "normalized_dominance_slack"
      ],
      "title": "ProximityAxisSlack",
      "type": "object"
    },
    "RejectedOffering": {
      "additionalProperties": false,
      "properties": {
        "offering_id": {
          "title": "Offering Id",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "offering_id",
        "reasons"
      ],
      "title": "RejectedOffering",
      "type": "object"
    },
    "SecondaryFrontierReference": {
      "additionalProperties": false,
      "properties": {
        "frontier_id": {
          "minLength": 1,
          "title": "Frontier Id",
          "type": "string"
        },
        "frontier_snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Frontier Snapshot Id",
          "type": "string"
        },
        "frontier_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Frontier Snapshot Hash",
          "type": "string"
        },
        "proximity_snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Proximity Snapshot Id",
          "type": "string"
        },
        "near_epsilon": {
          "anyOf": [
            {
              "maxLength": 1024,
              "pattern": "^[+-]?\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Near Epsilon"
        },
        "max_age_seconds": {
          "maximum": 31536000,
          "minimum": 1,
          "title": "Max Age Seconds",
          "type": "integer"
        }
      },
      "required": [
        "frontier_id",
        "frontier_snapshot_id",
        "frontier_snapshot_hash",
        "proximity_snapshot_id",
        "max_age_seconds"
      ],
      "title": "SecondaryFrontierReference",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "pattern": "^https?://[^@?#]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "terms_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "pattern": "^https?://[^@?#]+$",
              "type": "string"
            },
            {
