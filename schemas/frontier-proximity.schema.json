{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:model-skyline:schema:v1alpha1:frontier-proximity",
  "$defs": {
    "AxisDescriptor": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "goal": {
          "$ref": "#/$defs/Goal"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "epsilon_absolute": {
          "default": "0",
          "maxLength": 1024,
          "pattern": "^[+-]?\\d+(?:\\.\\d+)?$",
          "title": "Epsilon Absolute",
          "type": "string"
        },
        "epsilon_relative": {
          "default": "0",
          "maxLength": 1024,
          "pattern": "^[+-]?\\d+(?:\\.\\d+)?$",
          "title": "Epsilon Relative",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "goal",
        "unit"
      ],
      "title": "AxisDescriptor",
      "type": "object"
    },
    "DominanceInterval": {
      "additionalProperties": false,
      "properties": {
        "dominator": {
          "$ref": "#/$defs/OfferingKey"
        },
        "enters_at_epsilon": {
          "maxLength": 36,
          "pattern": "^(?:0|1|2|[01]\\.\\d{0,33}[1-9])$",
          "title": "Enters At Epsilon",
          "type": "string"
        },
        "exits_at_epsilon": {
          "maxLength": 36,
          "pattern": "^(?:1|2|[01]\\.\\d{0,33}[1-9])$",
          "title": "Exits At Epsilon",
          "type": "string"
        }
      },
      "required": [
        "dominator",
        "enters_at_epsilon",
        "exits_at_epsilon"
      ],
      "title": "DominanceInterval",
      "type": "object"
    },
    "Goal": {
      "enum": [
        "minimize",
        "maximize"
      ],
      "title": "Goal",
      "type": "string"
    },
    "OfferingKey": {
      "additionalProperties": false,
      "description": "Identity grain for a routable candidate, narrower than model name.",
      "properties": {
        "offering_id": {
          "minLength": 1,
          "title": "Offering Id",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "billing_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Billing Mode"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "service_tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Tier"
        },
        "quantization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantization"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "agent_harness": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Harness"
        },
        "capabilities": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Capabilities",
          "type": "array"
        }
      },
      "required": [
        "offering_id",
        "model_id",
        "provider"
      ],
      "title": "OfferingKey",
      "type": "object"
    },
    "OfferingProximity": {
      "additionalProperties": false,
      "properties": {
        "offering": {
          "$ref": "#/$defs/OfferingKey"
        },
        "exact_member": {
          "title": "Exact Member",
          "type": "boolean"
        },
        "axis_slacks": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/ProximityAxisSlack"
            },
            {
              "$ref": "#/$defs/ProximityAxisSlack"
            }
          ],
          "title": "Axis Slacks",
          "type": "array"
        },
        "blocking_dominance_intervals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DominanceInterval"
          },
          "maxItems": 128,
          "title": "Blocking Dominance Intervals",
          "type": "array"
        },
        "minimal_relative_epsilon": {
          "maxLength": 36,
          "pattern": "^(?:0|1|2|[01]\\.\\d{0,33}[1-9])$",
          "title": "Minimal Relative Epsilon",
          "type": "string"
        }
      },
      "required": [
        "offering",
        "exact_member",
        "axis_slacks",
        "minimal_relative_epsilon"
      ],
      "title": "OfferingProximity",
      "type": "object"
    },
    "ProximityAxisSlack": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "normalized_dominance_slack": {
          "maxLength": 36,
          "pattern": "^(?:0|1|2|[01]\\.\\d{0,33}[1-9])$",
          "title": "Normalized Dominance Slack",
          "type": "string"
        },
        "witnesses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OfferingKey"
          },
          "maxItems": 128,
          "title": "Witnesses",
          "type": "array"
        }
      },
      "required": [
        "metric",
        "normalized_dominance_slack"
      ],
      "title": "ProximityAxisSlack",
      "type": "object"
    },
    "UncertaintyMode": {
      "enum": [
        "point",
        "robust"
      ],
      "title": "UncertaintyMode",
      "type": "string"
    },
    "WorkloadReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "unit"
      ],
      "title": "WorkloadReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "model-skyline/proximity/v1alpha1",
      "default": "model-skyline/proximity/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "frontier-proximity",
      "default": "frontier-proximity",
      "title": "Kind",
      "type": "string"
    },
    "hash_algorithm": {
      "const": "sha256-rfc8785-v1",
      "default": "sha256-rfc8785-v1",
      "title": "Hash Algorithm",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "algorithm_version": {
      "const": "dominance-interval-epsilon-grid-34-v1",
      "default": "dominance-interval-epsilon-grid-34-v1",
      "title": "Algorithm Version",
      "type": "string"
    },
    "source_frontier_id": {
      "minLength": 1,
      "title": "Source Frontier Id",
      "type": "string"
    },
    "source_frontier_snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Frontier Snapshot Id",
      "type": "string"
    },
    "source_frontier_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Frontier Snapshot Hash",
      "type": "string"
    },
    "candidate_universe_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Universe Hash",
      "type": "string"
    },
    "member_universe_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Member Universe Hash",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "workload": {
      "$ref": "#/$defs/WorkloadReference"
    },
    "uncertainty": {
      "$ref": "#/$defs/UncertaintyMode"
    },
    "axes": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/AxisDescriptor"
        },
        {
          "$ref": "#/$defs/AxisDescriptor"
        }
      ],
      "title": "Axes",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/OfferingProximity"
      },
      "maxItems": 128,
      "title": "Candidates",
      "type": "array"
    }
  },
  "required": [
    "snapshot_id",
    "source_frontier_id",
    "source_frontier_snapshot_id",
    "source_frontier_snapshot_hash",
    "candidate_universe_hash",
    "member_universe_hash",
    "generated_at",
    "workload",
    "uncertainty",
    "axes",
    "candidates"
  ],
  "title": "FrontierProximitySnapshot",
  "type": "object"
}
