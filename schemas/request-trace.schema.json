{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:model-skyline:schema:v1alpha1:request-trace",
  "$defs": {
    "TraceClassification": {
      "additionalProperties": false,
      "description": "Optional task-class annotation on a request trace (ADR 0002).\n\nThe object is present-or-absent as a unit; inside it every member is\nrequired so no incoherent partial state (source without class, class\nwithout confidence) can be expressed.",
      "properties": {
        "class_id": {
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*){0,4}$",
          "title": "Class Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/TraceClassificationSource"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!-)(?=[+]?(?:0*(?:\\.\\d*)?|0*1(?:\\.0*)?)$)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,9}|(?=[\\d.]{1,19}0*$)\\d{0,9}\\.\\d{0,9}0*$))$",
              "type": "string",
              "maxLength": 1024
            }
          ],
          "title": "Confidence"
        }
      },
      "required": [
        "class_id",
        "source",
        "confidence"
      ],
      "title": "TraceClassification",
      "type": "object"
    },
    "TraceClassificationMethod": {
      "description": "How a trace's task class was decided (ADR 0002).",
      "enum": [
        "harness_tag",
        "operator",
        "registered_classifier",
        "oracle"
      ],
      "title": "TraceClassificationMethod",
      "type": "string"
    },
    "TraceClassificationSource": {
      "additionalProperties": false,
      "description": "Versioned provenance for one task-class decision.\n\nDeterministic classifiers are registered code referenced by ``id`` and\n``version`` (with ``sha256`` digest when available); model-based\nclassifiers must be versioned oracles behind the oracle boundary. Only\ncode and version identifiers are recorded here \u2014 never executable logic.",
      "properties": {
        "method": {
          "$ref": "#/$defs/TraceClassificationMethod"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "method"
      ],
      "title": "TraceClassificationSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical request-level trace row consumed by the DuckDB aggregator.",
  "properties": {
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "workload_id": {
      "minLength": 1,
      "title": "Workload Id",
      "type": "string"
    },
    "workload_version": {
      "minLength": 1,
      "title": "Workload Version",
      "type": "string"
    },
    "work_unit_id": {
      "minLength": 1,
      "title": "Work Unit Id",
      "type": "string"
    },
    "offering_id": {
      "minLength": 1,
      "title": "Offering Id",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "work_unit_success": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!-)(?=[+]?(?:0*(?:\\.\\d*)?|0*1(?:\\.0*)?)$)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,9}|(?=[\\d.]{1,19}0*$)\\d{0,9}\\.\\d{0,9}0*$))$",
          "type": "string",
          "maxLength": 1024
        }
      ],
      "title": "Work Unit Success"
    },
    "input_uncached_tokens": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,29}|(?=[\\d.]{1,39}0*$)\\d{0,29}\\.\\d{0,9}0*$))$",
          "type": "string",
          "maxLength": 1024
        }
      ],
      "default": "0",
      "title": "Input Uncached Tokens"
    },
    "input_cache_read_tokens": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,29}|(?=[\\d.]{1,39}0*$)\\d{0,29}\\.\\d{0,9}0*$))$",
          "type": "string",
          "maxLength": 1024
        }
      ],
      "default": "0",
      "title": "Input Cache Read Tokens"
    },
    "input_cache_write_5m_tokens": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,29}|(?=[\\d.]{1,39}0*$)\\d{0,29}\\.\\d{0,9}0*$))$",
          "type": "string",
          "maxLength": 1024
        }
      ],
      "default": "0",
      "title": "Input Cache Write 5M Tokens"
    },
    "input_cache_write_1h_tokens": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,29}|(?=[\\d.]{1,39}0*$)\\d{0,29}\\.\\d{0,9}0*$))$",
          "type": "string",
          "maxLength": 1024
        }
      ],
      "default": "0",
      "title": "Input Cache Write 1H Tokens"
    },
    "cache_storage_token_hours": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,29}|(?=[\\d.]{1,39}0*$)\\d{0,29}\\.\\d{0,9}0*$))$",
          "type": "string",
          "maxLength": 1024
        }
      ],
      "default": "0",
      "title": "Cache Storage Token Hours"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,29}|(?=[\\d.]{1,39}0*$)\\d{0,29}\\.\\d{0,9}0*$))$",
          "type": "string",
          "maxLength": 1024
        }
      ],
      "default": "0",
      "title": "Output Tokens"
    },
    "reasoning_tokens": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,29}|(?=[\\d.]{1,39}0*$)\\d{0,29}\\.\\d{0,9}0*$))$",
          "type": "string",
          "maxLength": 1024
        }
      ],
      "default": "0",
      "title": "Reasoning Tokens"
    },
    "tool_calls": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,29}|(?=[\\d.]{1,39}0*$)\\d{0,29}\\.\\d{0,9}0*$))$",
          "type": "string",
          "maxLength": 1024
        }
      ],
      "default": "0",
      "title": "Tool Calls"
    },
    "web_search_calls": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,29}|(?=[\\d.]{1,39}0*$)\\d{0,29}\\.\\d{0,9}0*$))$",
          "type": "string",
          "maxLength": 1024
        }
      ],
      "default": "0",
      "title": "Web Search Calls"
    },
    "sandbox_seconds": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,29}|(?=[\\d.]{1,39}0*$)\\d{0,29}\\.\\d{0,9}0*$))$",
          "type": "string",
          "maxLength": 1024
        }
      ],
      "default": "0",
      "title": "Sandbox Seconds"
    },
    "other_cost_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*(?:\\d{0,26}|(?=[\\d.]{1,39}0*$)\\d{0,26}\\.\\d{0,12}0*$))$",
          "type": "string",
          "maxLength": 1024
        }
      ],
      "default": "0",
      "title": "Other Cost Usd"
    },
    "ttft_ms": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*)$",
              "type": "string",
              "maxLength": 1024
            }
          ],
          "decimal_places": 9,
          "max_digits": 38
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ttft Ms"
    },
    "output_tokens_per_second": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "pattern": "^(?!-)(?:(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*)$",
              "type": "string",
              "maxLength": 1024
            }
          ],
          "decimal_places": 9,
          "max_digits": 38
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens Per Second"
    },
    "trace_classification": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceClassification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "timestamp",
    "workload_id",
    "workload_version",
    "work_unit_id",
    "offering_id",
    "request_id",
    "attempt_id",
    "work_unit_success"
  ],
  "title": "RequestTrace",
  "type": "object"
}
