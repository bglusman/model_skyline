{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:model-skyline:schema:v1alpha1:quality-bundle-policy",
  "$defs": {
    "AxisDescriptor": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "goal": {
          "$ref": "#/$defs/Goal"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "epsilon_absolute": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?:(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*)$",
              "type": "string",
              "maxLength": 1024
            }
          ],
          "default": "0",
          "title": "Epsilon Absolute"
        },
        "epsilon_relative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?:(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*)$",
              "type": "string",
              "maxLength": 1024
            }
          ],
          "default": "0",
          "title": "Epsilon Relative"
        }
      },
      "required": [
        "metric",
        "goal",
        "unit"
      ],
      "title": "AxisDescriptor",
      "type": "object"
    },
    "Goal": {
      "enum": [
        "minimize",
        "maximize"
      ],
      "title": "Goal",
      "type": "string"
    },
    "QualityBundleComponent": {
      "additionalProperties": false,
      "description": "One exact frontier declared as a distinct quality component by policy.",
      "properties": {
        "component_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "frontier_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Frontier Id",
          "type": "string"
        },
        "frontier_snapshot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Frontier Snapshot Id",
          "type": "string"
        },
        "frontier_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Frontier Snapshot Hash",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "catalog_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Hash",
          "type": "string"
        },
        "workload": {
          "$ref": "#/$defs/WorkloadReference"
        },
        "axes": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/AxisDescriptor"
            },
            {
              "$ref": "#/$defs/AxisDescriptor"
            }
          ],
          "title": "Axes",
          "type": "array"
        },
        "quality_metric": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Quality Metric",
          "type": "string"
        },
        "max_age_seconds": {
          "maximum": 31536000,
          "minimum": 1,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "evidence_valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Valid Until"
        }
      },
      "required": [
        "component_id",
        "frontier_id",
        "frontier_snapshot_id",
        "frontier_snapshot_hash",
        "config_hash",
        "catalog_hash",
        "workload",
        "axes",
        "quality_metric",
        "max_age_seconds"
      ],
      "title": "QualityBundleComponent",
      "type": "object"
    },
    "WorkloadReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "unit"
      ],
      "title": "WorkloadReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Hard coverage policy over two to four separate quality frontiers.",
  "properties": {
    "schema_version": {
      "const": "model-skyline/quality-bundle-policy/v1alpha1",
      "default": "model-skyline/quality-bundle-policy/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "quality-bundle-policy",
      "default": "quality-bundle-policy",
      "title": "Kind",
      "type": "string"
    },
    "bundle_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Bundle Id",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "strategy": {
      "const": "separate-frontiers",
      "default": "separate-frontiers",
      "title": "Strategy",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/QualityBundleComponent"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Components",
      "type": "array",
      "uniqueItems": true
    },
    "required_component_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Required Component Ids",
      "type": "array",
      "uniqueItems": true
    },
    "minimum_measured_components": {
      "maximum": 4,
      "minimum": 1,
      "title": "Minimum Measured Components",
      "type": "integer"
    }
  },
  "required": [
    "bundle_id",
    "version",
    "components",
    "required_component_ids",
    "minimum_measured_components"
  ],
  "title": "QualityBundlePolicy",
  "type": "object",
  "$comment": "uniqueItems compares complete JSON values; it does not enforce unique component IDs, frontier IDs, or snapshot IDs. JSON Schema also cannot enforce the required-ID subset and measured-count relationships. Run the ModelSkyline semantic validator before building or accepting a bundle."
}
