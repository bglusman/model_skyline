{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:model-skyline:schema:gateway-trust-policy:v1alpha1",
  "$defs": {
    "GatewayPublicJwk": {
      "additionalProperties": false,
      "properties": {
        "crv": {
          "const": "Ed25519",
          "title": "Crv",
          "type": "string"
        },
        "kty": {
          "const": "OKP",
          "title": "Kty",
          "type": "string"
        },
        "x": {
          "contentEncoding": "base64url",
          "maxLength": 43,
          "minLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "title": "X",
          "type": "string"
        }
      },
      "required": [
        "crv",
        "kty",
        "x"
      ],
      "title": "GatewayPublicJwk",
      "type": "object"
    },
    "GatewayTargetBinding": {
      "additionalProperties": false,
      "description": "Local-only binding; no remote endpoint or credential is accepted.",
      "properties": {
        "offering": {
          "$ref": "#/$defs/OfferingKey"
        },
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Target Id",
          "type": "string"
        },
        "target_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Revision",
          "type": "string"
        },
        "capabilities": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "offering",
        "target_id",
        "target_revision"
      ],
      "title": "GatewayTargetBinding",
      "type": "object"
    },
    "GatewayTrustedKey": {
      "additionalProperties": false,
      "properties": {
        "keyid": {
          "format": "uri",
          "maxLength": 88,
          "minLength": 88,
          "pattern": "^urn:ietf:params:oauth:jwk-thumbprint:sha-256:[A-Za-z0-9_-]{43}$",
          "title": "Keyid",
          "type": "string"
        },
        "algorithm": {
          "const": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "public_jwk": {
          "$ref": "#/$defs/GatewayPublicJwk"
        }
      },
      "required": [
        "keyid",
        "algorithm",
        "public_jwk"
      ],
      "title": "GatewayTrustedKey",
      "type": "object"
    },
    "OfferingKey": {
      "additionalProperties": false,
      "description": "Identity grain for a routable candidate, narrower than model name.",
      "properties": {
        "offering_id": {
          "minLength": 1,
          "title": "Offering Id",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "billing_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Billing Mode"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "service_tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Tier"
        },
        "quantization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantization"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "agent_harness": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Harness"
        },
        "capabilities": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Capabilities",
          "type": "array"
        }
      },
      "required": [
        "offering_id",
        "model_id",
        "provider"
      ],
      "title": "OfferingKey",
      "type": "object"
    },
    "WorkloadReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "unit"
      ],
      "title": "WorkloadReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "trust_namespace": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Trust Namespace",
      "type": "string"
    },
    "issuer": {
      "format": "uri",
      "maxLength": 2083,
      "pattern": "^https://[^@%\\\\?#]+[^/@%\\\\?#]$",
      "title": "Issuer",
      "type": "string"
    },
    "audience": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Audience",
      "type": "string"
    },
    "channel": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Channel",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Project Id",
      "type": "string"
    },
    "trusted_keys": {
      "items": {
        "$ref": "#/$defs/GatewayTrustedKey"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Trusted Keys",
      "type": "array"
    },
    "signature_threshold": {
      "default": 1,
      "maximum": 16,
      "minimum": 1,
      "title": "Signature Threshold",
      "type": "integer"
    },
    "expected_selection_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Expected Selection Id",
      "type": "string"
    },
    "expected_frontier_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Expected Frontier Id",
      "type": "string"
    },
    "expected_workload": {
      "$ref": "#/$defs/WorkloadReference"
    },
    "expected_policy_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Policy Hash"
    },
    "required_capabilities": {
      "default": [],
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$",
        "type": "string"
      },
      "maxItems": 128,
      "title": "Required Capabilities",
      "type": "array",
      "uniqueItems": true
    },
    "target_bindings": {
      "items": {
        "$ref": "#/$defs/GatewayTargetBinding"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Target Bindings",
      "type": "array"
    },
    "minimum_sequence": {
      "default": 1,
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Minimum Sequence",
      "type": "integer"
    },
    "max_future_skew_seconds": {
      "default": 300,
      "maximum": 300,
      "minimum": 0,
      "title": "Max Future Skew Seconds",
      "type": "integer"
    },
    "max_pointer_lifetime_seconds": {
      "default": 3600,
      "maximum": 2678400,
      "minimum": 1,
      "title": "Max Pointer Lifetime Seconds",
      "type": "integer"
    },
    "max_pointer_age_seconds": {
      "default": 86400,
      "maximum": 2678400,
      "minimum": 1,
      "title": "Max Pointer Age Seconds",
      "type": "integer"
    },
    "max_artifact_bytes": {
      "default": 2097152,
      "maximum": 10485760,
      "minimum": 1,
      "title": "Max Artifact Bytes",
      "type": "integer"
    },
    "max_candidates": {
      "default": 128,
      "maximum": 1024,
      "minimum": 1,
      "title": "Max Candidates",
      "type": "integer"
    }
  },
  "required": [
    "trust_namespace",
    "issuer",
    "audience",
    "channel",
    "project_id",
    "trusted_keys",
    "expected_selection_id",
    "expected_frontier_id",
    "expected_workload",
    "target_bindings"
  ],
  "title": "GatewayTrustPolicy",
  "type": "object",
  "$comment": "Structural validation is not routing authorization. Consumers MUST also perform the signature, canonical-byte, time, sequence, semantic-artifact, exact OfferingKey mapping, capability, and atomic-install verification order defined by docs/adr/0003-signed-gateway-selection-protocol.md."
}
