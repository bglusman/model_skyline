      "title": "Observation Unit",
      "type": "string"
    },
    "model_request_count": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Actual model requests represented by an aggregate row; unknown when omitted. Request rows implicitly represent one.",
      "title": "Model Request Count"
