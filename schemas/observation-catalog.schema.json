{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:model-skyline:schema:v1alpha1:observation-catalog",
  "$defs": {
    "JsonValue": {},
    "Observation": {
      "additionalProperties": false,
      "description": "One value with enough context to decide whether it can be trusted.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?:(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*)$",
              "type": "string",
              "maxLength": 1024
            }
          ],
          "title": "Value"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?:(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*)$",
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?:(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*)$",
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "sample_count": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Count"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Observation",
      "type": "object"
    },
    "OfferingKey": {
      "additionalProperties": false,
      "description": "Identity grain for a routable candidate, narrower than model name.",
      "properties": {
        "offering_id": {
          "minLength": 1,
          "title": "Offering Id",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "service_tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Tier"
        },
        "quantization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantization"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "agent_harness": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Harness"
        },
        "capabilities": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Capabilities",
          "type": "array"
        }
      },
      "required": [
        "offering_id",
        "model_id",
        "provider"
      ],
      "title": "OfferingKey",
      "type": "object"
    },
    "OfferingObservation": {
      "additionalProperties": false,
      "properties": {
        "offering": {
          "$ref": "#/$defs/OfferingKey"
        },
        "signals": {
          "additionalProperties": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Signals",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "default_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "offering",
        "signals"
      ],
      "title": "OfferingObservation",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "pattern": "^https?://[^@?#]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "terms_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "pattern": "^https?://[^@?#]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Url"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "methodology": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Methodology"
        },
        "raw_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Sha256"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        }
      },
      "required": [
        "id"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "WorkloadReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "unit"
      ],
      "title": "WorkloadReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "model-skyline/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "workload": {
      "$ref": "#/$defs/WorkloadReference"
    },
    "offerings": {
      "items": {
        "$ref": "#/$defs/OfferingObservation"
      },
      "title": "Offerings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "workload",
    "offerings"
  ],
  "title": "ObservationCatalog",
  "type": "object"
}
