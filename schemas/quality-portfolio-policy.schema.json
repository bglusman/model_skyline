{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:model-skyline:schema:v1alpha1:quality-portfolio-policy",
  "$defs": {
    "AxisDescriptor": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "goal": {
          "$ref": "#/$defs/Goal"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "epsilon_absolute": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?:(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*)$",
              "type": "string",
              "maxLength": 1024
            }
          ],
          "default": "0",
          "title": "Epsilon Absolute"
        },
        "epsilon_relative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?:(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*)$",
              "type": "string",
              "maxLength": 1024
            }
          ],
          "default": "0",
          "title": "Epsilon Relative"
        }
      },
      "required": [
        "metric",
        "goal",
        "unit"
      ],
      "title": "AxisDescriptor",
      "type": "object"
    },
    "Goal": {
      "enum": [
        "minimize",
        "maximize"
      ],
      "title": "Goal",
      "type": "string"
    },
    "PortfolioComponent": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Component Id",
          "type": "string"
        },
        "frontier_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Frontier Id",
          "type": "string"
        },
        "workload": {
          "$ref": "#/$defs/WorkloadReference"
        },
        "quality_axis": {
          "$ref": "#/$defs/AxisDescriptor"
        },
        "output_signal": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Output Signal",
          "type": "string"
        },
        "max_age_seconds": {
          "maximum": 31536000,
          "minimum": 1,
          "title": "Max Age Seconds",
          "type": "integer"
        },
        "correlation_group": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
          "title": "Correlation Group",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "frontier_id",
        "workload",
        "quality_axis",
        "output_signal",
        "max_age_seconds",
        "correlation_group"
      ],
      "title": "PortfolioComponent",
      "type": "object"
    },
    "WorkloadReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "unit"
      ],
      "title": "WorkloadReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "model-skyline/quality-portfolio-policy/v1alpha1",
      "default": "model-skyline/quality-portfolio-policy/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "quality-portfolio-policy",
      "default": "quality-portfolio-policy",
      "title": "Kind",
      "type": "string"
    },
    "portfolio_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Portfolio Id",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "output_workload": {
      "$ref": "#/$defs/WorkloadReference"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/PortfolioComponent"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Components",
      "type": "array",
      "uniqueItems": true
    },
    "required_component_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Required Component Ids",
      "type": "array",
      "uniqueItems": true
    },
    "minimum_measured_components": {
      "maximum": 4,
      "minimum": 1,
      "title": "Minimum Measured Components",
      "type": "integer"
    },
    "correlation_rationale": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Correlation Rationale",
      "type": "string"
    },
    "statistical_independence_assumed": {
      "const": false,
      "default": false,
      "title": "Statistical Independence Assumed",
      "type": "boolean"
    }
  },
  "required": [
    "portfolio_id",
    "version",
    "output_workload",
    "components",
    "required_component_ids",
    "minimum_measured_components",
    "correlation_rationale"
  ],
  "title": "PortfolioPolicy",
  "type": "object",
  "$comment": "This stable policy contains operator intent only; exact frontier snapshots, catalog/config hashes, retrievals, rights, and candidate failures belong in the derivation lock. JSON Schema cannot enforce distinct component/frontier IDs, unique output signals, required coverage, or correlation grouping; run ModelSkyline semantic validation."
}
