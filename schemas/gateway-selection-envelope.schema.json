{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:model-skyline:schema:gateway-selection-envelope:v1alpha1",
  "$defs": {
    "DsseSignature": {
      "additionalProperties": false,
      "properties": {
        "keyid": {
          "format": "uri",
          "maxLength": 88,
          "minLength": 88,
          "pattern": "^urn:ietf:params:oauth:jwk-thumbprint:sha-256:[A-Za-z0-9_-]{43}$",
          "title": "Keyid",
          "type": "string"
        },
        "sig": {
          "contentEncoding": "base64",
          "maxLength": 88,
          "minLength": 88,
          "pattern": "^(?:[A-Za-z0-9+/]{4}){21}[A-Za-z0-9+/]{2}==$",
          "title": "Sig",
          "type": "string"
        }
      },
      "required": [
        "keyid",
        "sig"
      ],
      "title": "DsseSignature",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "payloadType": {
      "const": "application/vnd.model-skyline.gateway-selection-pointer.v1alpha1+json",
      "title": "Payloadtype",
      "type": "string"
    },
    "payload": {
      "contentEncoding": "base64",
      "maxLength": 43692,
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "title": "Payload",
      "type": "string"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/DsseSignature"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Signatures",
      "type": "array"
    }
  },
  "required": [
    "payloadType",
    "payload",
    "signatures"
  ],
  "title": "DsseEnvelope",
  "type": "object",
  "$comment": "Structural validation is not routing authorization. Consumers MUST also perform the signature, canonical-byte, time, sequence, semantic-artifact, exact OfferingKey mapping, capability, and atomic-install verification order defined by docs/adr/0003-signed-gateway-selection-protocol.md."
}
