  "methodology": "Redacted synthetic holdout derived from observed BookLore, Bookshelf, Audiobookshelf, and Biblioaudio failure classes. It evaluates advisory routing for proposed catalog pairs; it contains no private catalog records and does not authorize writes.",
  "question": {
    "name": "route",
    "instructions": "Choose the safe handling route for the proposed pair. Link only when evidence establishes the same underlying work and there is no known language, abridgement, or coverage conflict. Separate when evidence establishes different works or incompatible content. Abstain for human review when evidence is missing, internally inconsistent, or metadata must be repaired before identity can be trusted.",
    "criteria": {
      "link": "Treat the records as the same compatible work for advisory pairing; this does not itself mutate either catalog.",
      "separate": "Treat the records as different or content-incompatible; do not pair them.",
      "abstain": "Do not decide automatically; repair or obtain missing identity evidence and have a human review the pair."
    }
  },
